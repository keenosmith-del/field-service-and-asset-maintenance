<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<TargetFrameworks>net10.0-android</TargetFrameworks>
<TargetFrameworks Condition="'$(EnableAppleTargets)' == 'true'">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
<OutputType>Exe</OutputType><RootNamespace>FieldService.Mobile</RootNamespace><UseMaui>true</UseMaui><SingleProject>true</SingleProject>
<ApplicationTitle>Field Service</ApplicationTitle><ApplicationId>com.fieldservice.maintenance</ApplicationId><ApplicationDisplayVersion>1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
</PropertyGroup>
<ItemGroup><PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" /><PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" /><ProjectReference Include="../FieldService.Mobile.Core/FieldService.Mobile.Core.csproj" /></ItemGroup>
<ItemGroup><MauiIcon Include="Resources/AppIcon/appicon.svg"/><MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#16625D" BaseSize="128,128"/></ItemGroup>
<ItemGroup Condition="'$(Configuration)' == 'Release'">
<AndroidResource Remove="Platforms/Android/Resources/xml/network_security_config.xml" />
<AndroidResource Include="Platforms/Android/Resources/xml/release_network_security.xml" LogicalName="xml/network_security_config.xml" />
</ItemGroup>
<ItemGroup Condition="'$(Configuration)' != 'Release'"><AndroidResource Remove="Platforms/Android/Resources/xml/release_network_security.xml" /></ItemGroup>
</Project>
