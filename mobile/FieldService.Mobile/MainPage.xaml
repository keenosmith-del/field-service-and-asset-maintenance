<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="FieldService.Mobile.MainPage" Title="Field Service" BackgroundColor="#F3F6F7">
<ScrollView><VerticalStackLayout Padding="20" Spacing="12">
<Label Text="Technician workspace" FontSize="26" FontAttributes="Bold"/>
<Label Text="{Binding ConnectionStatus}"/><Label Text="{Binding Message}" TextColor="#A34116"/>
<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
<VerticalStackLayout IsVisible="{Binding ShowLogin}" Spacing="10">
<Entry Text="{Binding ApiUrl}" Placeholder="API URL"/><Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email"/><Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True"/>
<Button Text="Sign in" Command="{Binding LoginCommand}"/>
</VerticalStackLayout>
<VerticalStackLayout IsVisible="{Binding IsSignedIn}" Spacing="10">
<Label Text="{Binding UserName}" FontAttributes="Bold"/>
<HorizontalStackLayout Spacing="8"><Button Text="Download jobs" Command="{Binding DownloadCommand}"/><Button Text="Sync / retry" Command="{Binding SyncCommand}"/></HorizontalStackLayout>
<Button Text="Sign out (local work retained)" Command="{Binding LogoutCommand}"/>
<Label Text="Assigned jobs · persisted on this device" FontSize="18"/>
<VerticalStackLayout BindableLayout.ItemsSource="{Binding Jobs}"><BindableLayout.ItemTemplate><DataTemplate>
<Border Margin="0,4" Padding="12" Stroke="#CCDADD"><VerticalStackLayout Spacing="4"><Label Text="{Binding Title}" FontAttributes="Bold"/><Label Text="{Binding Summary}"/><Label Text="{Binding State}" TextColor="#16625D"/><Button Text="Open inspection" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},Path=BindingContext.OpenCommand}" CommandParameter="{Binding .}"/></VerticalStackLayout></Border>
</DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
</VerticalStackLayout>
</VerticalStackLayout></ScrollView></ContentPage>
